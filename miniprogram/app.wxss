/** app.wxss —— 全局浅色清新健康风 */
page {
  background-color: #f7f8f7;
  color: #1a1a1a;
  font-size: 28rpx;
  line-height: 1.6;
}

/* 通用卡片 */
.card {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 32rpx;
  margin: 20rpx 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.card-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1a1a1a;
  margin-bottom: 16rpx;
}

/* 主按钮 */
.btn-primary {
  background: #07c160;
  color: #ffffff;
  border-radius: 48rpx;
  font-size: 32rpx;
  font-weight: 600;
  padding: 24rpx 0;
  text-align: center;
  margin: 24rpx;
}
.btn-primary:active { opacity: 0.85; }
.btn-primary.disabled {
  background: #c9cec9;
}

.btn-plain {
  background: #eef7f1;
  color: #07c160;
  border-radius: 48rpx;
  font-size: 30rpx;
  font-weight: 600;
  padding: 20rpx 0;
  text-align: center;
  margin: 16rpx 24rpx;
}

/* 大数字 */
.big-num {
  font-size: 64rpx;
  font-weight: 700;
  color: #1a1a1a;
}
.big-num .unit {
  font-size: 26rpx;
  font-weight: 400;
  color: #8a8f8a;
}

.text-secondary { color: #666; }
.text-hint { color: #999; font-size: 24rpx; }

/* AI 生成标注 */
.ai-tag {
  font-size: 22rpx;
  color: #b0b5b0;
  text-align: right;
  margin-top: 12rpx;
}

/* 合规页脚 */
.compliance-footer {
  font-size: 22rpx;
  color: #b0b5b0;
  text-align: center;
  padding: 24rpx;
  line-height: 1.8;
}

/* 进度条 */
.progress-track {
  height: 16rpx;
  background: #eef1ee;
  border-radius: 8rpx;
  overflow: hidden;
}
.progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #34c759, #07c160);
  border-radius: 8rpx;
}

/* 表单 */
.form-label {
  font-size: 28rpx;
  color: #666;
  margin: 24rpx 0 12rpx;
}
.form-input {
  background: #f2f5f2;
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  font-size: 32rpx;
  min-height: 48rpx;
}
