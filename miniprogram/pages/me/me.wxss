/* pages/me/me.wxss */
.container { padding-bottom: 40rpx; }

.persona-line {
  display: flex; justify-content: space-between; align-items: center;
  margin: 8rpx 0 16rpx;
}
.persona-name { font-size: 36rpx; font-weight: 700; }
.switch-btn {
  font-size: 26rpx; color: #07c160; background: #eef7f1;
  border-radius: 32rpx; padding: 10rpx 28rpx;
}

.info-row {
  display: flex; justify-content: space-between; align-items: center;
  padding: 14rpx 0; border-top: 1rpx solid #f0f2f0;
}
.info-val { font-size: 30rpx; font-weight: 600; }

.menu-item {
  display: flex; justify-content: space-between; align-items: center;
  padding: 24rpx 0; font-size: 30rpx; border-bottom: 1rpx solid #f0f2f0;
}
.menu-item:last-child { border-bottom: none; }
.menu-item .arrow { color: #c9cec9; font-size: 40rpx; }
.menu-item.danger { color: #fa5151; justify-content: center; }
