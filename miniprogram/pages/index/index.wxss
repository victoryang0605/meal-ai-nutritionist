/* pages/index/index.wxss */
.container { padding-bottom: 40rpx; }
.loading-wrap { padding: 120rpx; text-align: center; }

.budget-text { font-size: 26rpx; color: #666; margin: 8rpx 0 16rpx; }
.progress-track { margin-top: 8rpx; }

.risk-card { border-left: 8rpx solid #07c160; }
.risk-badge {
  display: inline-block;
  font-size: 34rpx;
  font-weight: 700;
  padding: 12rpx 28rpx;
  border-radius: 40rpx;
  margin: 8rpx 0 12rpx;
  color: #fff;
}
.risk-high { background: #fa5151; }
.risk-mid { background: #fa9d3b; }
.risk-low { background: #07c160; }

.shoot-btn {
  background: linear-gradient(135deg, #07c160, #34c759);
  border-radius: 32rpx;
  margin: 8rpx 24rpx 8rpx;
  padding: 44rpx;
  text-align: center;
  color: #fff;
  box-shadow: 0 8rpx 24rpx rgba(7, 193, 96, 0.3);
}
.shoot-btn:active { opacity: 0.9; }
.shoot-emoji { font-size: 64rpx; }
.shoot-text { font-size: 40rpx; font-weight: 700; margin-top: 8rpx; }
.shoot-sub { font-size: 24rpx; opacity: 0.85; margin-top: 4rpx; }

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  margin: 32rpx 32rpx 8rpx;
}

/* 今日三餐 · 2×2 四宫格
   注意：不要用「width:42% + margin:2%」这种百分比叠加换行，
   百分比是相对父容器算的，叠加后总宽会溢出导致第三项挤到下一行。
   这里改用 calc(50% - 间隙/2)，两列严格对齐。 */
.meal-grid {
  display: flex;
  flex-wrap: wrap;
  padding: 0 24rpx;
}
.meal-cell {
  width: calc(50% - 8rpx);
  box-sizing: border-box;
  padding-bottom: 16rpx;
}
.meal-cell:nth-child(odd) { margin-right: 16rpx; }

.meal-card {
  background: #fff;
  border-radius: 24rpx;
  padding: 24rpx 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
  min-height: 240rpx;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
}
.meal-card.is-logged { box-shadow: 0 4rpx 16rpx rgba(7, 193, 96, 0.12); }
.meal-card:active { opacity: 0.85; }

.meal-head {
  display: flex;
  align-items: center;
  margin-bottom: 8rpx;
}
.meal-emoji { font-size: 36rpx; margin-right: 8rpx; }
.meal-name { font-size: 28rpx; font-weight: 600; color: #2c2c2a; }

/* 已记录态：热量数值 */
.meal-kcal {
  font-size: 36rpx;
  font-weight: 700;
  color: #07c160;
  line-height: 1.1;
  word-break: break-all;
}
.meal-kcal .dash { color: #b0b5b0; margin: 0 2rpx; }
.meal-kcal-unit { font-size: 22rpx; color: #8a8f8a; margin-top: 2rpx; }

.meal-dish {
  font-size: 22rpx;
  color: #8a8f8a;
  margin-top: 8rpx;
  /* 单行超出省略，四宫格内不让长菜名撑破卡片 */
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.meal-tags { display: flex; flex-wrap: wrap; margin-top: 10rpx; }
.tag {
  font-size: 20rpx;
  padding: 3rpx 12rpx;
  border-radius: 16rpx;
  margin-right: 8rpx;
  color: #fff;
  line-height: 1.4;
}
.tag-score { background: #f0f2ef; color: #5f5e5a; }

/* 未记录态：占位 + 号 */
.meal-empty {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}
.meal-plus {
  width: 56rpx;
  height: 56rpx;
  /* flex 居中替代 line-height，确保 + 号严格居中 */
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: #f0f2ef;
  color: #b0b5b0;
  font-size: 36rpx;
  font-weight: 300;
}
.meal-empty-text { font-size: 22rpx; color: #b0b5b0; margin-top: 10rpx; }

/* .risk-high/.risk-mid/.risk-low 的配色已在文件上方定义，此处复用 */

.row-between {
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.arrow { font-size: 48rpx; color: #c9cec9; }

/* 热量超限醒目提示 */
.over-limit {
  color: #e64340;
  font-weight: 700;
  font-size: 36rpx;
  margin-top: 16rpx;
  text-align: center;
}
