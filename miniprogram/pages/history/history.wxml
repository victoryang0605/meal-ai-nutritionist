<!-- pages/history/history.wxml -->
<view class="container" wx:if="{{!loading}}">

  <view class="btn-primary" bindtap="recordNow">记录这次{{mealName}}</view>
  <view class="text-hint center" wx:if="{{mealType !== 'snack'}}">早/午/晚餐每天只保留最新一条，重复记录会自动替换</view>

  <block wx:if="{{!empty}}">
    <view class="section-title">之前记录（近 30 天）</view>
    <block wx:for="{{records}}" wx:key="id">
      <view class="card record-card" data-id="{{item.id}}" bindtap="toggleExpand">
        <view class="row-between">
          <view class="record-date">{{item.date}}</view>
          <view class="record-score" wx:if="{{item.mealScore !== null}}">{{item.mealScore}} 分</view>
        </view>
        <view class="record-kcal">{{item.kcalLow}}-{{item.kcalHigh}} kcal</view>
        <view class="record-dishes">{{item.dishNames}}</view>
        <block wx:if="{{item.expanded}}">
          <!-- 菜品明细：内层循环显式命名，避免遮蔽外层 item -->
          <view class="dish-detail" wx:for="{{item.dishes}}" wx:for-item="dish" wx:key="index">
            <view class="row-between">
              <text>{{dish.name}}</text>
              <text class="kcal">{{dish.kcalRange}}</text>
            </view>
            <view class="text-hint" wx:if="{{dish.isEstimate}}">⚠️ 估算值</view>
          </view>

          <!-- AI 诊断详情（2026-10-17）：落库后回看完整解读 -->
          <view class="ai-block">

            <!-- 升糖风险（仅控糖画像） -->
            <view class="risk-line" wx:if="{{item.glycemicRisk}}">
              <text class="risk-badge risk-{{item.glycemicRisk === '高' ? 'high' : item.glycemicRisk === '中' ? 'mid' : 'low'}}">
                升糖风险 {{item.glycemicRisk}}
              </text>
            </view>

            <!-- AI 建议 -->
            <view class="ai-section" wx:if="{{item.suggestion}}">
              <view class="ai-label">AI 建议</view>
              <view class="ai-text">{{item.suggestion}}</view>
            </view>

            <!-- 亮点 -->
            <view class="ai-section" wx:if="{{item.highlights.length}}">
              <view class="ai-label">这餐的优点</view>
              <view class="ai-item" wx:for="{{item.highlights}}" wx:for-item="h" wx:key="index">
                <text class="ai-bullet good">·</text><text>{{h}}</text>
              </view>
            </view>

            <!-- 警示 -->
            <view class="ai-section" wx:if="{{item.warnings.length}}">
              <view class="ai-label">需要注意</view>
              <view class="ai-item" wx:for="{{item.warnings}}" wx:for-item="w" wx:key="index">
                <text class="ai-bullet warn">!</text><text>{{w}}</text>
              </view>
            </view>

            <!-- 控糖：升糖说明与进食顺序 -->
            <view class="ai-section" wx:if="{{item.giNotes}}">
              <view class="ai-label">升糖说明</view>
              <view class="ai-text">{{item.giNotes}}</view>
            </view>
            <view class="ai-section" wx:if="{{item.mealOrderTip}}">
              <view class="ai-label">建议这样吃</view>
              <view class="ai-text">{{item.mealOrderTip}}</view>
            </view>

            <view class="ai-tag">以上为 AI 生成内容，仅供参考</view>
          </view>
        </block>
        <view class="expand-hint">{{item.expanded ? '收起 ↑' : '展开看明细 ↓'}}</view>
      </view>
    </block>
  </block>
  <block wx:else>
    <view class="empty-wrap">
      <view class="empty-emoji">🍽️</view>
      <view class="text-hint">这个餐位还没有历史记录</view>
    </view>
  </block>

  <view class="compliance-footer">AI 生成内容仅供参考</view>
</view>

<view class="loading-wrap" wx:else>
  <text class="text-hint">加载中...</text>
</view>
