<!-- pages/checkin/checkin.wxml -->
<view class="container">

  <view class="card streak-card">
    <view class="streak-num">{{streak}}<text class="unit"> 天</text></view>
    <view class="streak-label">连续打卡</view>
    <view class="text-hint">断签不扣分，明天继续就是胜利 ✌️</view>
  </view>

  <!-- 今日三餐：四宫格 -->
  <view class="section-title">今日三餐</view>
  <view class="slot-grid">
    <block wx:for="{{slots}}" wx:key="type">
      <view class="slot-cell" data-type="{{item.type}}" bindtap="tapSlot">
        <view class="slot-emoji">{{item.emoji}}</view>
        <view class="slot-name">{{item.name}}</view>
        <block wx:if="{{item.logged}}">
          <view class="slot-info">{{item.dishCount}} 道菜</view>
          <view class="slot-kcal">{{item.kcalText}}</view>
        </block>
        <block wx:else>
          <view class="slot-empty">待记录 +</view>
        </block>
      </view>
    </block>
  </view>
  <view class="text-hint center">点格子查看该餐位的历史记录</view>

  <!-- 每日打卡提醒 -->
  <view class="card row-between">
    <view>
      <view class="card-title">每日打卡提醒</view>
      <view class="text-hint">{{reminderOn ? '已开启：当天没记录，晚上 8 点微信提醒你' : '当天没打开小程序，晚上 8 点微信提醒你打卡'}}</view>
    </view>
    <view class="switch-btn {{reminderOn ? 'on' : ''}}" bindtap="toggleReminder">{{reminderOn ? '已开启' : '开启'}}</view>
  </view>

  <view class="card">
    <view class="cal-header">
      <view class="cal-nav" bindtap="prevMonth">‹</view>
      <view class="cal-title">{{year}} 年 {{month + 1}} 月</view>
      <view class="cal-nav" bindtap="nextMonth">›</view>
    </view>
    <view class="cal-week">
      <text>日</text><text>一</text><text>二</text><text>三</text><text>四</text><text>五</text><text>六</text>
    </view>
    <block wx:for="{{weeks}}" wx:key="index">
      <view class="cal-row">
        <block wx:for="{{item.days}}" wx:key="index">
          <view class="cal-cell {{it && it.isToday ? 'today' : ''}}">
            <block wx:if="{{it}}">
              <text>{{it.day}}</text>
              <view class="dot" wx:if="{{it.checked}}"></view>
            </block>
          </view>
        </block>
      </view>
    </block>
    <view class="month-count">本月已打卡 {{monthCount}} 天</view>
  </view>

  <view class="btn-primary" bindtap="goShoot">去记录今日三餐</view>
  <view class="compliance-footer">AI 生成内容仅供参考</view>
</view>
