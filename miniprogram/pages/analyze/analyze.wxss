/* pages/analyze/analyze.wxss */
.container { padding-bottom: 60rpx; }
.loading-wrap { text-align: center; padding: 160rpx 40rpx; font-size: 32rpx; }
.loading-emoji { font-size: 96rpx; margin-bottom: 24rpx; }

.score-row { display: flex; align-items: center; }
.score-wrap { position: relative; width: 180rpx; height: 180rpx; margin-right: 32rpx; flex-shrink: 0; }
.score-ring { width: 180rpx; height: 180rpx; }
.score-num {
  position: absolute; inset: 0;
  display: flex; align-items: center; justify-content: center;
  font-size: 56rpx; font-weight: 700;
}
.score-num .unit { font-size: 24rpx; color: #8a8f8a; font-weight: 400; }
.score-info { flex: 1; }
.picker-box {
  background: #f2f5f2; border-radius: 12rpx;
  padding: 12rpx 20rpx; font-size: 26rpx; color: #07c160;
  display: inline-block; margin-top: 8rpx;
}

.risk-badge {
  display: inline-block; font-size: 32rpx; font-weight: 700;
  padding: 10rpx 28rpx; border-radius: 40rpx; color: #fff; margin-bottom: 12rpx;
}
.risk-high { background: #fa5151; }
.risk-mid { background: #fa9d3b; }
.risk-low { background: #07c160; }
.tip-box {
  background: #f0faf5; border-radius: 16rpx;
  padding: 20rpx 24rpx; margin-top: 16rpx; font-size: 28rpx;
}
.tip-title { font-weight: 600; margin-bottom: 8rpx; }

.dish-row {
  display: flex; align-items: center;
  padding: 20rpx 0; border-bottom: 1rpx solid #f0f2f0;
}
.dish-row:last-child { border-bottom: none; }
.dish-main { flex: 1; }
.dish-name { font-size: 30rpx; font-weight: 600; }
.est-tag {
  font-size: 20rpx; color: #fa9d3b; background: #fef6ec;
  border-radius: 8rpx; padding: 2rpx 10rpx; margin-left: 8rpx;
}
.dish-sub { font-size: 24rpx; color: #8a8f8a; margin-top: 4rpx; }
.dish-kcal { font-size: 30rpx; font-weight: 700; color: #07c160; margin: 0 16rpx; }
.dish-kcal .unit { font-size: 22rpx; font-weight: 400; }
.dish-del {
  width: 56rpx; height: 56rpx; line-height: 56rpx; text-align: center;
  border-radius: 50%; background: #f7f8f7; color: #b0b5b0; font-size: 28rpx;
}

.suggestion { font-size: 30rpx; line-height: 1.9; }
.warn-item { font-size: 26rpx; color: #fa9d3b; margin-top: 12rpx; line-height: 1.7; }

.back-link { text-align: center; color: #8a8f8a; font-size: 26rpx; margin-top: 8rpx; }
