/* pages/weight/weight.wxss */
.container { padding-bottom: 40rpx; }

/*
 * 体重输入框（2026-10-17 二次修正）
 *
 * 真机问题：文字「62.5」上半部分被裁切 —— 这不是宽度不够，
 * 而是 **input 没有显式 height，只靠 padding 撑高**。
 * 小程序 input 在 iOS 上有默认行高约束，font-size 变大后
 * 行高跟不上，文字顶部就会被裁掉一截（底部留白还在，所以像"下沉"）。
 *
 * 修法：
 *   1. 显式给 height + line-height，让行高与字号匹配，文字完整可见；
 *   2. kg 单位移进输入框内右侧（绝对定位），输入框得以占满整行宽度 ——
 *      既符合"改宽一点"的需求，也省掉外层 flex 的宽度分配。
 */
.input-row {
  position: relative;
  margin: 12rpx 0;
}
.weight-input {
  width: 100%;
  height: 112rpx;
  line-height: 112rpx;
  background: #f2f5f2;
  border-radius: 20rpx;
  /* 左右 padding 必须对称，否则 text-align:center 的视觉中心会偏移 */
  padding: 0 100rpx;
  font-size: 60rpx;
  font-weight: 400;
  text-align: center;
  box-sizing: border-box;
}
.unit {
  position: absolute;
  right: 32rpx;
  top: 50%;
  transform: translateY(-50%);
  font-size: 30rpx;
  color: #8a8f8a;
}

.feedback {
  background: #f0faf5; border-radius: 16rpx;
  padding: 20rpx 24rpx; margin-top: 16rpx;
  font-size: 28rpx; color: #1a7a3f;
}

.curve { width: 100%; height: 320rpx; }
