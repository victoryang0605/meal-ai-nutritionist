# ============================================================
# 三餐 AI 营养师 —— 环境变量模板
# ------------------------------------------------------------
# ⚠️ 本文件只放占位符，绝不提交真实 Key/Secret。
# 真实值只放在：本地.env（已在.gitignore）或云托管控制台的环境变量。
# ============================================================

# ============================================================
# Agnes AI 免费全模态 API（OpenAI 兼容）配置
# ------------------------------------------------------------
# 注册获取免费 API Key：https://platform.agnes-ai.com
# Settings -> API Keys -> Create new secret key
#
# Base URL（按需选择节点）：
# 国际主节点: https://apihub.agnes-ai.com/v1
# 国际备用线路: https://apihub.agnes-ai.cn/v1
# 国内服务节点: https://api.agnes-ai.cn/v1 （需在国内站注册获取 Key）
# ------------------------------------------------------------
AGNES_BASE_URL="https://apihub.agnes-ai.com/v1"
AGNES_API_KEY="YOUR_AGNES_API_KEY"

# 识图模型（照片 -> 结构化 JSON），当前免费
AGNES_VISION_MODEL="agnes-2.5-flash"

# ============================================================
# DeepSeek 识图模型（OpenAI 兼容，国内直连）
# ------------------------------------------------------------
# Key 获取：https://platform.deepseek.com 注册充值
# - 配了 DEEPSEEK_API_KEY 时默认优先 DeepSeek
# - DeepSeek 失败会自动回退 Agnes（15 秒内切换，不重试）
# - 不配 DEEPSEEK_API_KEY 则全程走 Agnes
#
# ⚠️ 模型名务必按官方现行版本配置：
# deepseek-v4-flash —— 快、便宜，识图推荐
# deepseek-v4-pro —— 强推理，贵 4 倍以上，仅在确需高质量推理时用
# 官方价目：https://api-docs.deepseek.com/quick_start/pricing
# ============================================================
DEEPSEEK_API_KEY="YOUR_DEEPSEEK_API_KEY"
# DEEPSEEK_BASE_URL="https://api.deepseek.com"
# DEEPSEEK_CHAT_MODEL="deepseek-v4-flash"

# ============================================================
# 微信小程序登录（wx.login -> jscode2session）
# ------------------------------------------------------------
# AppID: 公众平台「开发管理 -> 开发设置」可见
# Secret: 公众平台「开发管理 -> 开发设置 -> 小程序密钥」（生成后仅显示一次）
# 均为敏感信息，只放服务端环境变量，绝不入库/进前端/进代码仓库
# ------------------------------------------------------------
WX_APPID="wx____________________"
WX_SECRET="YOUR_WX_SECRET"

# ============================================================
# 每日打卡提醒（订阅消息）
# ------------------------------------------------------------
# Victor 在小程序后台「订阅消息」申请到「打卡提醒」类模板后，
# 把模板 ID 填到这里，并按模板实际字段调整 server.ts 里
# sendSubscribeMessage 的 data 组装（有 TODO 注释）。
# 不填则每日 20:00 定时任务自动跳过。
# ------------------------------------------------------------
REMINDER_TEMPLATE_ID=""

# ============================================================
# MySQL 8.0 数据库（微信云托管 MySQL）
# ------------------------------------------------------------
# 云托管控制台 -> MySQL 实例 -> 连接信息
# 数据库首次启动时自动建表，无需手动执行 SQL
# ------------------------------------------------------------
MYSQL_HOST="127.0.0.1"
MYSQL_PORT="3306"
MYSQL_USER="root"
MYSQL_PASSWORD="YOUR_MYSQL_PASSWORD"
MYSQL_DATABASE="meal_nutritionist"

# ============================================================
# 微信支付 v3（JSAPI 小程序支付 · 微信支付公钥模式）
# ------------------------------------------------------------
# 商户平台: https://pay.weixin.qq.com
# API安全 → 设置APIv3密钥 / 申请API证书 / 下载微信支付公钥
# ------------------------------------------------------------
# 商户号（商户平台首页可见）
WX_PAY_MCHID="YOUR_MCHID"
# APIv3密钥（自己设的32位字符串）
WX_PAY_API_V3_KEY="YOUR_API_V3_KEY"
# 商户API证书序列号（API安全页面可见）
WX_PAY_SERIAL_NO="YOUR_CERT_SERIAL_NO"
# 商户API证书私钥（apiclient_key.pem 内容，换行改 \n）
WX_PAY_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY\n-----END PRIVATE KEY-----"
# 微信支付公钥（API安全 → 微信支付公钥 → 下载 pem 文件内容，换行改 \n）
WX_PAY_PUB_KEY="-----BEGIN PUBLIC KEY-----\nYOUR_PUB_KEY\n-----END PUBLIC KEY-----"
# 微信支付公钥ID（商户平台 API安全 页面可见）
WX_PAY_PUB_KEY_ID="YOUR_PUB_KEY_ID"
# 支付回调地址
WX_PAY_NOTIFY_URL="https://api.cooperelate.com/api/payment/notify"

# ============================================================
# 虚拟支付（米大师）—— 虚拟商品强制要求
# ------------------------------------------------------------
# ⚠️ 微信自2026-04-01 起强制：虚拟商品（含AI 生成次数/额度、会员、解锁功能）
# 必须全终端接入虚拟支付，不得再用普通微信支付（wx.requestPayment）。
# 本项目的会员/次数包属官方《虚拟支付业务运营指南》「场景二 AI 服务付费」。
#
# 开通路径：MP 后台 →→→ 开通并签约
# 开通条件：已认证小程序 + 主体为企业/事业单位/个体工商户 + 服务类目含「工具」
#
# 获取参数：虚拟支付 → 基本配置
# OfferID（支付账号）→ VX_OFFER_ID
# 现网 AppKey（支付签名密钥）→ VX_APP_KEY
# 沙箱 AppKey（测试用）→ VX_SANDBOX_APP_KEY
#
# 道具配置：虚拟支付 → 道具管理，为每个会员/次数包创建一个道具并发布。
# ⚠️ 道具价格（分）必须与代码中 PRICING_PLANS 的 price*100 一致，否则报-15013
# ⚠️ 道具发布后名称与价格不可修改，请谨慎规划
#
# 官方文档：
# 能力说明 https://developers.weixin.qq.com/miniprogram/dev/platform-capabilities/business-capabilities/virtual-payment.html
# 客户端 API https://developers.weixin.qq.com/miniprogram/dev/api/payment/wx.requestVirtualPayment.html
# ------------------------------------------------------------
VX_OFFER_ID="YOUR_OFFER_ID"
VX_APP_KEY="YOUR_APP_KEY"
# VX_SANDBOX_APP_KEY="YOUR_SANDBOX_APP_KEY"

# 发货推送 Token —— 与 MP 后台「虚拟支付 → 发货推送配置」中填写的值**必须一致**
# 生成方式：node -e "console.log(require('crypto').randomBytes(16).toString('hex'))"
# ⚠️ 未配置时发货推送接口会拒绝所有请求（fail-closed），
# 这是为了防止任何人伪造推送请求白嫖付费次数。
# ⚠️ 泄露后果：他人可伪造发货推送，绕过支付直接增加次数。请勿提交进仓库。
VX_PUSH_TOKEN="YOUR_PUSH_TOKEN"

# EncodingAESKey（消息加解密密钥，43 位）
# 仅当 MP 后台「消息推送」的消息加密方式选择**安全模式**时必填；
# 明文模式可不填。取自后台的「EncodingAESKey（消息加密密钥）」。
# ⚠️ 改动此值或后台加密方式后需同步更新此处并重启服务。
VX_ENCODING_AES_KEY="YOUR_ENCODING_AES_KEY_43_CHARS"

# ============================================================
# 阿里云 OSS（餐食图片临时托管）
# ------------------------------------------------------------
# 用途：AI 识图需要图片以**公网可访问 URL** 传入时使用；
# 默认走本服务自建图床（IMAGE_HOST_MODE=self），无需配置本节。
# 设为 oss 模式才需要以下配置。
#
# ⚠️⚠️ Bucket 区域建议「华东2（上海）」cn-shanghai！
#
#
# · Bucket 建议设为「私有」
# · 上传后生成 **5 分钟有效的签名 URL** 供识别服务下载
# · 分析完成后**及时删除** OSS 对象，不留存量
#
# ⚠️⚠️OSS_CUSTOM_DOMAIN
# 原因：使用 OSS **默认域名**访问文件时，OSS 强制返回
# Content-Disposition: attachment（**强制下载**而非内联预览），
# 部分识别服务下载到该响应时无法按图片解析。
# 上传时设 Content-Disposition:inline **无效**
# （默认域名的行为由服务端控制，不接受对象元数据覆盖）。
# OSS 官方提示亦要求绑定自定义域名才能在线预览。
#
#
# 1. 准备已备案域名，如 img.example.com
# 2. OSS 控制台 → Bucket → 数据传输 → 自定义域名 → 绑定
# 3. 域名服务商加 CNAME：img.example.com → <bucket>.oss-cn-shanghai.aliyuncs.com
# 4. 填入下方（**含协议前缀**）
# ============================================================
# OSS_BUCKET="meal-nutritionist"
# OSS_REGION="cn-shanghai"
#
# 二选一：
# private（默认）—— Bucket 保持私有，上传后生成 **5 分钟有效的签名 URL**
# public —— Bucket ACL 设为「公共读」，直接用标准域名直链
# https://<bucket>.oss-cn-shanghai.aliyuncs.com/<key>
# OSS_ACL_MODE="private"
#
# OSS_CUSTOM_DOMAIN="https://img.example.com"
# OSS_SIGN_TTL_SEC=300 # 仅 private 模式使用
# OSS_ACCESS_KEY_ID="YOUR_OSS_ACCESS_KEY_ID"
# OSS_ACCESS_KEY_SECRET="YOUR_OSS_ACCESS_KEY_SECRET"

# ============================================================
# 开发测试登录（⚠️ 生产环境绝不配置 = 留后门）
# ------------------------------------------------------------
# 仅本地/联调使用：配置后 /api/auth/dev-login 可用用户名密码登录，
# 绕过微信 OAuth。生产环境留空即 404 关闭。
# ------------------------------------------------------------
# DEV_USER="test"
# DEV_PASS="change-me"
